generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteSettings {
  id                  Int     @id @default(1)
  hero_title          String? @default("We help you choose the right tattoo")
  hero_subtitle       String? @default("Not just any tattoo.")
  hero_description    String? @default("A consultation-led process built around anatomy, symbolism and long term aesthetics.")
  hero_image          String?
  hero_video          String?
  home_piercing_kids_image   String?
  home_piercing_adults_image String?
  cta_title           String? @default("Zenspace — Where your story becomes timeless art")
  cta_subtitle        String? @default("Custom tattoos crafted with passion, precision and meaning.")
  address             String? @default("Shop No. 101, 1st Floor, Zenspace Art and Tattoo, Akruti Commercial Complex, MIDC Central Rd, Near Akruti Centre Point, Gautam Nagar, Chakala Industrial Area (MIDC), Andheri East, Mumbai, Maharashtra 400093")
  email               String? @default("zenspace32@gmail.com")
  phone               String? @default("+91 7208388209 / +91 8652144521")
  whatsapp            String?
  instagram           String?
  facebook            String?
  pinterest           String?
  piercing_title      String?
  piercing_intro      String?
  piercing_baby_blurb String?

  aftercare_pdf         String?
  piercing_kids_title   String?
  piercing_kids_intro   String?
  piercing_adults_title String?
  piercing_adults_intro String?

  about_title   String? @default("Workspace where we create magic")
  about_heading String? @default("About Zenspace")
  about_body    String?
  about_photo_1 String?
  about_photo_2 String?

  // Google reviews badge (contact page). Count is updated by the studio as the
  // real Google count grows; the URL points at the public Google listing.
  google_review_count Int?    @default(193)
  google_reviews_url  String? @default("https://share.google/pSxgjeACR2Lh3WI9P")

  @@map("site_settings")
}

// Admin login password, editable from the admin panel. Kept OUT of site_settings
// because that table is publicly readable via the Supabase anon key (RLS
// `using (true)`); admin_auth has RLS enabled with no public policy, so only the
// server's direct Prisma connection (which bypasses RLS) can read/write it.
model AdminAuth {
  id       Int    @id @default(1)
  username String @default("Zenspace123")
  password String @default("zenspace123098#")

  @@map("admin_auth")
}

model ShortVideo {
  id         String  @id @default(uuid()) @db.Uuid
  video      String
  poster     String?
  caption    String?
  sort_order Int?    @default(0)

  @@map("short_videos")
}

model EarringOption {
  id         String  @id @default(uuid()) @db.Uuid
  audience   String
  metal      String
  photo      String?
  benefits   String?
  sort_order Int?    @default(0)

  @@map("earring_options")
}

model CustomRequest {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  phone       String
  email       String?
  description String
  reference   String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@map("custom_requests")
}

model Artist {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  slug          String?         @unique
  role          String?
  photo         String?
  portfolio_url String?
  experience    String?
  specialty     String?
  bio           String?
  sort_order    Int?            @default(0)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  portfolio     PortfolioItem[]

  @@map("artists")
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String?         @unique
  photo       String?
  description String?
  sort_order  Int?            @default(0)
  photos      CategoryPhoto[]

  @@map("categories")
}

model CategoryPhoto {
  id          String    @id @default(uuid()) @db.Uuid
  category_id String?   @db.Uuid
  photo       String
  caption     String?
  sort_order  Int?      @default(0)
  category    Category? @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@map("category_photos")
}

model StudioPhoto {
  id         String  @id @default(uuid()) @db.Uuid
  photo      String
  caption    String?
  sort_order Int?    @default(0)

  @@map("studio_photos")
}

model PiercingPhoto {
  id         String  @id @default(uuid()) @db.Uuid
  photo      String
  caption    String?
  audience   String  @default("adults")
  sort_order Int?    @default(0)

  @@map("piercing_photos")
}

model Review {
  id          String  @id @default(uuid()) @db.Uuid
  client_name String
  photo       String?
  video       String?
  review      String?
  rating      Int?    @default(5)
  sort_order  Int?    @default(0)

  @@map("reviews")
}

model PortfolioItem {
  id         String  @id @default(uuid()) @db.Uuid
  artist_id  String? @db.Uuid
  photo      String
  title      String?
  sort_order Int?    @default(0)
  artist     Artist? @relation(fields: [artist_id], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model EarringCategory {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  audience    String // "kids" | "adults" | "both"
  description String?
  photo       String?
  sort_order  Int?             @default(0)
  products    EarringProduct[]

  @@map("earring_categories")
}

model EarringProduct {
  id          String          @id @default(uuid()) @db.Uuid
  category_id String          @db.Uuid
  category    EarringCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  name        String
  photo       String?
  price_inr   Int?
  description String?
  sort_order  Int?            @default(0)

  @@map("earring_products")
}

model ServiceForm {
  id          String                  @id @default(uuid()) @db.Uuid
  slug        String                  @unique
  title       String
  intro       String?
  sort_order  Int?                    @default(0)
  fields      ServiceFormField[]
  submissions ServiceFormSubmission[]

  @@map("service_forms")
}

model ServiceFormField {
  id         String      @id @default(uuid()) @db.Uuid
  form_id    String      @db.Uuid
  form       ServiceForm @relation(fields: [form_id], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       String
  required   Boolean     @default(false)
  options    String[]    @default([])
  sort_order Int?        @default(0)

  @@unique([form_id, key])
  @@map("service_form_fields")
}

model ServiceFormSubmission {
  id         String      @id @default(uuid()) @db.Uuid
  form_id    String      @db.Uuid
  form       ServiceForm @relation(fields: [form_id], references: [id])
  payload    Json
  status     String      @default("new")
  created_at DateTime    @default(now())

  @@map("service_form_submissions")
}

model SafetyItem {
  id         String  @id @default(uuid()) @db.Uuid
  audience   String
  title      String
  body       String
  photo      String?
  sort_order Int?    @default(0)

  @@map("safety_items")
}

model BlogPost {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique
  title        String
  excerpt      String?
  cover_image  String?
  blocks       Json      @default("[]")
  published    Boolean   @default(false)
  published_at DateTime? @db.Timestamptz(6)
  sort_order   Int?      @default(0)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@map("blog_posts")
}

model LegalPage {
  id         String    @id @default(uuid()) @db.Uuid
  slug       String    @unique // "terms" | "privacy"
  title      String
  blocks     Json      @default("[]")
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("legal_pages")
}
